site_url: https://example.github.io
host: example.github.io
sitemap: sitemap.xml

# Local submit ledger (dedupe + retry). Written under tmp/seo_submit/ (gitignored).
submit_state:
  enabled: true
  dir: tmp/seo_submit
  skip_within_days:
    indexnow: 7
    archive_org: 30
    archive_today: 30
    ghostarchive: 30
    bing: 7
    brave: 14
    websub: 1
    default: 7

sitemap_generate:
  static:
    - /
  globs:
    - pages/*.html

indexnow:
  enabled: true
  key: YOUR_INDEXNOW_KEY
  key_location: https://example.github.io/YOUR_INDEXNOW_KEY.txt
  # Omit endpoints to ping relay + Bing, Yandex, Seznam, Yep, and Internet Archive.
  endpoints:
    - https://api.indexnow.org/indexnow
    - https://www.bing.com/indexnow
    - https://yandex.com/indexnow
    - https://search.seznam.cz/indexnow
    - https://indexnow.yep.com/indexnow
    - https://indexnow.amazonbot.amazon/indexnow
  batch_size: 10000

websub:
  enabled: true
  feed_url: https://example.github.io/feed.xml
  hubs:
    - https://pubsubhubbub.appspot.com/
    - https://pubsubhubbub.superfeedr.com/

archive_org:
  enabled: false
  endpoint: https://web.archive.org/save
  rate_limit_seconds: 5
  rate_limit_backoff_seconds: 60
  max_retries: 3
  wait_for_status: false
  options:
    force_get: 1
    skip_first_archive: 1
    js_behavior_timeout: 0
    if_not_archived_within: 7d

archive_today:
  enabled: false
  rate_limit_seconds: 15
  skip_if_archived: true
  max_urls: 0
  hosts:
    - archive.ph
    - archive.md
    - archive.li
    - archive.vn
    - archive.fo
    - archive.today
    - archive.is

# Ghost Archive has no public API; submit form is Cloudflare-protected.
# Uses scripts/playwright/submit.mjs provider=ghostarchive.
ghostarchive:
  enabled: false
  rate_limit_seconds: 8
  skip_if_archived: true
  max_urls: 0
  headed: false
  timeout_ms: 60000
  results_path: tmp/seo_audit/ghostarchive_playwright_results.json
  # Setup: cd scripts/playwright && npm install && npx playwright install chromium
  # If Cloudflare challenges, re-run with headed: true (or --ghostarchive-only after enabling).

brave:
  enabled: false
  # mode: manual | open | request | playwright
  mode: playwright
  submit_page: https://search.brave.com/submit-url
  max_urls: 20
  rate_limit_seconds: 3
  headed: false
  slow_mo_ms: 0
  timeout_ms: 30000
  results_path: tmp/seo_audit/brave_playwright_results.json
  # Brave has no stable public submit API. mode options:
  #   manual — print URLs to paste at submit_page (default)
  #   open   — open submit_page in browser (macOS only)
  #   request — POST to brave.endpoint (experimental; often blocked)
  #   playwright — drive the submit form via scripts/playwright/submit.mjs
  # Setup: cd scripts/playwright && npm install && npx playwright install chromium

# Extra no-API providers (same Playwright helper). Add new names in submit.mjs PROVIDERS.
playwright:
  enabled: false
  headed: false
  rate_limit_seconds: 3
  timeout_ms: 30000
  results_path: tmp/seo_audit/playwright_results.json
  providers:
    - name: brave
      max_urls: 20

bing:
  enabled: false
  client_id:
  client_secret:
  redirect_uri: http://127.0.0.1:8765/callback
  scope: webmaster.manage
  batch_size: 500

sitemap_ping:
  enabled: true
  endpoints:
    - https://www.bing.com/ping?sitemap=
